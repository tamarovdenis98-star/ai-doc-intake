{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Тип документа",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc_type",
    "confidence"
  ],
  "properties": {
    "doc_type": {
      "type": "string",
      "enum": [
        "invoice",
        "act",
        "upd",
        "contract",
        "other"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    }
  }
}
