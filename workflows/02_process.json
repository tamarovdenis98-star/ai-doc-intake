  "name": "[DOCAI] 02 process",
  "nodes": [
    {
      "credentials": {
        "postgres": {
          "name": "DOCAI Postgres"
        }
      },
      "id": "77c929f6-8f5c-508e-a629-b19692eaa3f1",
      "name": "Claim",
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "WITH cfg AS (\n  SELECT coalesce((SELECT value::int FROM settings WHERE key = 'process_batch_size'), 3)   AS batch,\n         coalesce((SELECT value::int FROM settings WHERE key = 'process_max_attempts'), 4) AS max_att,\n         -- bounded concurrency: OCR and LLM calls of at most process_max_in_flight documents at once\n         greatest(0, coalesce((SELECT value::int FROM settings WHERE key = 'process_max_in_flight'), 3)\n                     - (SELECT count(*) FROM documents WHERE status = 'processing' AND locked_at > now() - interval '15 minutes')) AS room\n), picked AS (\n  SELECT d.id FROM documents d, cfg\n   WHERE ((d.status IN ('new', 'failed') AND d.next_attempt_at <= now())\n          OR (d.status = 'processing' AND d.locked_at < now() - interval '15 minutes'))\n     AND d.attempt_count < cfg.max_att\n   ORDER BY d.next_attempt_at, d.id\n   LIMIT (SELECT least(batch, room) FROM cfg)\n   FOR UPDATE OF d SKIP LOCKED\n)\nUPDATE documents d SET status = 'processing', locked_at = now(), attempt_count = d.attempt_count + 1, updated_at = now()\n  FROM picked WHERE d.id = picked.id\nRETURNING d.id AS doc_id, d.attempt_count"
      },
      "position": [
        220,
        300
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "754f3efc-294e-57b8-9307-377b8758b079",
      "name": "Claimed any?",
      "parameters": {
