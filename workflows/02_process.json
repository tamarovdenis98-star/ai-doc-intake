      "id": "438f4479-2fc9-552f-80e8-40309f3b72b9",
      "name": "Mark failed",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [$('Claim').item.json.doc_id, String($json.error?.message ?? $json.error ?? 'unknown error')] }}"
        },
        "query": "WITH cfg AS (SELECT coalesce((SELECT value::int FROM settings WHERE key = 'process_max_attempts'), 4) AS max_att),\nu AS (\n  UPDATE documents SET status = 'failed', last_error = left($2, 2000), locked_at = NULL, updated_at = now(),\n         next_attempt_at = now() + make_interval(mins => power(2, attempt_count - 1)::int)\n   WHERE id = $1 RETURNING id, attempt_count\n)\nINSERT INTO audit_log (doc_id, actor, action, detail)\nSELECT id, 'system', CASE WHEN attempt_count >= (SELECT max_att FROM cfg) THEN 'failed_final' ELSE 'failed_retry' END,\n       jsonb_build_object('attempt', attempt_count, 'error', left($2, 500)) FROM u\nRETURNING doc_id"
      },
      "position": [
        880,
        420
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
