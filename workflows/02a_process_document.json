        },
        "query": "WITH u AS (\n  UPDATE documents SET status = decision, processed_at = now(), locked_at = NULL, last_error = NULL, updated_at = now()\n   WHERE id = $1 RETURNING id, status, doc_type, decision, validation->'reasons' AS reasons, cost_rub, tokens_in + tokens_out AS tokens\n)\nINSERT INTO audit_log (doc_id, actor, action, detail)\nSELECT id, 'system', 'processed', jsonb_build_object('decision', decision, 'doc_type', doc_type, 'reasons', reasons,\n       'tokens', tokens, 'cost_rub', cost_rub, 'execution_id', $2::text) FROM u\nRETURNING doc_id, detail"
