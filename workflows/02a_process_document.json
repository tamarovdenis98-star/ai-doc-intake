      "id": "acace77b-b676-574a-8767-6b2af72d4c5e",
      "name": "Judge classify",
      "parameters": {
        "jsCode": "// 200 -> next step. 409 (LLM budget spent) / 422 (bad input: no text, unknown type) -> a human looks at it.\n// 503 (provider rate limit / outage) and anything else -> throw: the document is retried with backoff.\nconst r = $json, step = 'classify';\nconst body = r.body ?? {};\nif (r.statusCode === 200) return [{ json: { ok: true, step, result: body } }];\nif (r.statusCode === 409 || r.statusCode === 422)\n  return [{ json: { ok: false, step, review: true, reason: `${step}: ${body.error ?? 'HTTP ' + r.statusCode}` } }];\nthrow new Error(`extractor ${step}: HTTP ${r.statusCode} ${String(body.error ?? JSON.stringify(body)).slice(0, 300)}`);\n"
      },
      "position": [
