# Copy to .env and fill in. Never commit .env.
# --- Postgres ---
POSTGRES_DB=docai
POSTGRES_USER=docai_owner
POSTGRES_PASSWORD=change-me-owner
APP_DB_USER=docai_app
APP_DB_PASSWORD=change-me-app
POSTGRES_HOST_PORT=55442

# --- MinIO (S3) ---
MINIO_ROOT_USER=docai
MINIO_ROOT_PASSWORD=change-me-minio-long
S3_BUCKET=docai-originals
MINIO_HOST_PORT=59000

# --- extractor service ---
EXTRACTOR_HOST_PORT=58080
EXTRACTOR_TOKEN=change-me-extractor-token     # n8n sends it as X-Extractor-Token
MAX_FILE_MB=15

# --- LLM: provider is switched here, not in workflows ---
# rules | gigachat | yandex | openai
LLM_PROVIDER=rules
GIGACHAT_AUTH_KEY=               # "Authorization key" (base64 client_id:client_secret) from developers.sber.ru
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
YANDEX_API_KEY=                  # service account API key
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# price per 1000 tokens, RUB (in/out), used for the per-document cost limit
LLM_PRICE_IN_PER_1K=0
LLM_PRICE_OUT_PER_1K=0

# --- n8n (scripts only) ---
N8N_URL=https://n8n.example.com/
N8N_API_KEY=

# --- Telegram ---
TG_BOT_TOKEN=          # alerts (the same bot as b24-lead-hub is fine: it only sends)
TG_CHAT_ID=
TG_DOCS_BOT_TOKEN=     # separate bot: receives documents and button presses (one webhook per bot)
TG_REVIEW_CHAT_ID=     # where review cards go (default: TG_CHAT_ID)

# --- IMAP inbox for documents ---
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=          # app password
